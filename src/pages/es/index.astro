---
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero-placeholder.jpg';
import eddiePhoto from '../../assets/eddie-placeholder.jpg';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import TrustBadges from '../../components/ui/TrustBadges.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import ReviewCard from '../../components/ui/ReviewCard.astro';
import ServiceAreaMap from '../../components/ui/ServiceAreaMap.astro';
import EmergencyCTA from '../../components/ui/EmergencyCTA.astro';
import BlogCard from '../../components/ui/BlogCard.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const reviews = (await getCollection('reviews'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const neighborhoods = [
  'Irving Park',
  'Logan Square',
  'Avondale',
  'Roscoe Village',
  'Wicker Park',
  'Bucktown',
  'Lakeview',
  'Lincoln Square',
  'North Center',
  'Belmont-Cragin',
  'Hermosa',
  'Portage Park',
];
---

<PageLayout
  title="Plomero en Chicago — Disponible 24/7 | Sandoval Plumbing"
  description="Sandoval Plumbing — Su plomero de confianza en Chicago. 25+ años, 300+ reseñas de 5 estrellas. Disponible 24/7. Llame al (773) 610-3344."
  lang="es"
>
  <!-- C. HERO SECTION -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt="Sandoval Plumbing — Su plomero de confianza en Chicago, disponible 24/7"
        width={1600}
        height={800}
        loading="eager"
        class="w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-brand-blue/85 via-brand-blue/60 to-brand-blue/30"
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 py-20 md:py-28 w-full z-10">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-1 bg-white/20 text-white text-sm font-semibold px-3 py-1 rounded-full mb-6"
        >
          🔧 Propiedad Familiar Desde 1999
        </span>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-tight"
        >
          Su Plomero de Confianza en Chicago
          <span class="block text-brand-red">— Disponible 24 Horas, 7 Días</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-2xl leading-relaxed">
          Más de 25 años sirviendo a Chicago. Eddie Sandoval ofrece precios justos y servicio
          experto a su hogar — a cualquier hora, cualquier día.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <div class="flex text-yellow-400 text-lg" aria-label="4.9 de 5 estrellas">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
          </div>
          <span class="text-lg font-bold text-white">4.9 Estrellas</span>
          <span class="text-gray-300">|</span>
          <span class="text-gray-300">300+ Reseñas en Google</span>
        </div>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a
            href="tel:+17736103344"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-red text-white px-8 py-4 rounded-lg text-lg font-bold hover:opacity-90 transition shadow-lg"
          >
            <span aria-hidden="true">📞</span> Llame Ahora: (773) 610-3344
          </a>
          <a
            href="/contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-blue text-white px-8 py-4 rounded-lg text-lg font-bold hover:opacity-90 transition shadow-lg"
            >Presupuesto Gratis →</a
          >
        </div>
        <p class="mt-6 text-sm text-gray-300 flex items-center gap-1.5">
          <span aria-hidden="true">⚡</span> Le devolvemos la llamada en menos de 60 minutos
        </p>
      </div>
    </div>
  </section>

  <!-- D. TRUST BADGES BAR -->
  <TrustBadges />

  <!-- E. WHY SANDOVAL SECTION -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        ¿Por Qué Cientos de Propietarios en Chicago Eligen a Sandoval?
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-12">
        No somos una franquicia ni un centro de llamadas. Somos sus vecinos — y tratamos su hogar
        como el nuestro.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="text-4xl mb-4" aria-hidden="true">👨‍🔧</div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">Eddie Hace el Trabajo</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Cuando llama a Sandoval, habla directamente con Eddie — no con un operador ni un
            vendedor. Más de 25 años de experiencia práctica.
          </p>
        </div>
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="text-4xl mb-4" aria-hidden="true">💰</div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">
            Precios Justos y Transparentes
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Ahorramos a nuestros clientes 3–6 veces en comparación con las grandes compañías.
            Siempre sabrá el precio antes de empezar, sin cargos ocultos.
          </p>
        </div>
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="text-4xl mb-4" aria-hidden="true">⏰</div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">Disponible 24/7</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Noches, fines de semana y días festivos — nunca cerramos. Mientras otros le cobran el
            doble, Eddie le cobra la misma tarifa justa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- F. SERVICES GRID -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        Nuestros Servicios de Plomería
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-12">
        Plomería residencial y comercial — desde reparaciones de emergencia hasta remodelaciones
        completas.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              icon={service.data.icon}
              href={`/services/${service.data.slug}`}
              emergency={service.data.emergency}
            />
          ))
        }
      </div>
      <div class="text-center mt-10">
        <a
          href="/services"
          class="inline-flex items-center gap-2 bg-brand-blue text-white font-bold px-8 py-3.5 rounded-lg hover:opacity-90 transition shadow-md"
          >Ver Todos los Servicios →</a
        >
      </div>
    </div>
  </section>

  <!-- G. SOCIAL PROOF / REVIEWS -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mb-3">
            Lo Que Dicen Nuestros Clientes
          </h2>
          <p class="text-gray-500 max-w-xl">
            Con más de 300 reseñas de 5 estrellas en Google y Yelp, nuestro trabajo habla por sí
            mismo.
          </p>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="flex items-center gap-1.5 font-semibold"
            ><span class="text-blue-600">G</span> 4.9 ★</span
          >
          <span class="text-gray-300">|</span>
          <span class="flex items-center gap-1.5 font-semibold"
            ><span class="text-red-600">Y</span> 5.0 ★</span
          >
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          reviews.map((review) => (
            <ReviewCard
              reviewer={review.data.reviewer}
              rating={review.data.rating}
              platform={review.data.platform}
              text={review.body}
              verified={review.data.verified}
              date={review.data.date.toLocaleDateString('en-US', {
                month: 'short',
                year: 'numeric',
              })}
            />
          ))
        }
      </div>
      <div class="text-center mt-10">
        <a
          href="/reviews"
          class="inline-flex items-center gap-2 text-brand-blue font-bold hover:text-brand-red transition-colors"
          >Ver Todas las Reseñas →</a
        >
      </div>
    </div>
  </section>

  <!-- H. SERVICE AREA MAP -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        Servimos a Todo Chicago
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-8">
        Con sede en Irving Park, estamos a minutos de la mayoría de los vecindarios de Chicago.
      </p>
      <ServiceAreaMap />
      <div class="flex flex-wrap justify-center gap-2 mt-6">
        {
          neighborhoods.map((hood) => (
            <a
              key={hood}
              href={`/service-areas/${hood.toLowerCase().replace(/\s+/g, '-')}`}
              class="inline-block bg-white hover:bg-brand-blue hover:text-white text-gray-600 text-sm font-medium px-3 py-1.5 rounded-full border border-gray-200 hover:border-brand-blue transition-colors"
            >
              {hood}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- I. ABOUT SNIPPET -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="aspect-[4/3] rounded-xl overflow-hidden relative">
          <Image
            src={eddiePhoto}
            alt="Eduardo 'Eddie' Sandoval, propietario y plomero principal de Sandoval Plumbing — más de 25 años sirviendo a Chicago"
            width={600}
            height={750}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-brand-blue/20 to-transparent pointer-events-none"
            aria-hidden="true"
          >
          </div>
        </div>
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider"
            >Nuestra Historia</span
          >
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mt-2 mb-6">
            Más de 25 Años Manteniendo las Tuberías de Chicago en Funcionamiento
          </h2>
          <blockquote
            class="text-lg text-gray-600 leading-relaxed mb-6 border-l-4 border-brand-red pl-4 italic"
          >
            "Soy Eddie Sandoval. He estado reparando las tuberías de Chicago por más de 25 años.
            Comencé este negocio porque creo que los propietarios merecen un servicio honesto y
            asequible de alguien que realmente se presenta. Así seguimos operando hoy — un trabajo,
            un cliente, un precio justo a la vez."
          </blockquote>
          <p class="text-gray-500 mb-6">
            Propiedad hispana y operación familiar, nos enorgullece servir a las diversas
            comunidades de Chicago con servicio bilingüe y los mismos valores que hemos tenido desde
            el primer día.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-brand-blue font-bold hover:text-brand-red transition-colors"
            >Conozca Nuestra Historia →</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- J. EMERGENCY CTA -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-4xl mx-auto px-4">
      <EmergencyCTA />
    </div>
  </section>

  <!-- K. BLOG PREVIEW -->
  {
    blogPosts.length > 0 && (
      <section class="py-16 md:py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mb-3">
                Consejos de Plomería para Chicago
              </h2>
              <p class="text-gray-500 max-w-xl">
                Consejos de Eddie para mantener su plomería en óptimas condiciones durante cada
                temporada en Chicago.
              </p>
            </div>
            <a
              href="/blog"
              class="text-brand-blue font-bold hover:text-brand-red transition-colors"
            >
              Ver Todos los Artículos →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {blogPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- L. BILINGUAL CTA -->
  <section class="py-12 md:py-16 bg-brand-blue">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="text-4xl mb-4" aria-hidden="true">🌎</div>
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">
        ¿Prefiere el Inglés?
      </h2>
      <p class="text-gray-300 text-lg mb-6 max-w-xl mx-auto">
        También ofrecemos servicio completo en inglés. Eddie es bilingüe y atiende a todas las
        comunidades de Chicago con el mismo compromiso y calidad.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-white text-brand-blue font-bold px-8 py-3.5 rounded-lg hover:bg-gray-100 transition shadow-md"
          >Visitar en Inglés →</a
        >
        <a
          href="tel:+17736103344"
          class="inline-flex items-center gap-2 text-white font-bold hover:underline"
          >📞 (773) 610-3344</a
        >
      </div>
    </div>
  </section>
</PageLayout>
