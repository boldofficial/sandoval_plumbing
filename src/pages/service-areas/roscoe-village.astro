---
import { Phone, MapPin, Clock } from 'lucide-react';
import PageLayout from '../../layouts/PageLayout.astro';
import EmergencyCTA from '../../components/ui/EmergencyCTA.astro';
import ServiceAreaMap from '../../components/ui/ServiceAreaMap.astro';
import ContactForm from '../../components/islands/ContactForm';
---

<PageLayout
  title="Plumber in Roscoe Village, Chicago — 24/7 Service | Sandoval Plumbing"
  description="Need a plumber in Roscoe Village? Sandoval Plumbing offers 24/7 emergency service to Roscoe Village (60618) and surrounding Chicago neighborhoods. Call (773) 610-3344."
>
  <section class="py-16 md:py-24 bg-gradient-to-br from-brand-blue/5 to-brand-lightgray">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-brand-blue mb-6">
        Plumber in Roscoe Village, Chicago
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-8">
        Roscoe Village homeowners trust Sandoval Plumbing for honest, reliable service. Whether it's
        an emergency repair on a weekend or a planned bathroom renovation, Eddie provides the same
        personal attention and fair pricing that have earned us over 300 five-star reviews.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-brand-lightgray rounded-xl p-6">
          <h2 class="font-heading font-bold text-brand-blue text-lg mb-3">
            Our Services in Roscoe Village
          </h2>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Emergency Plumbing — 24/7 Response
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Drain Cleaning &amp; Hydro-Jetting
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Water Heater Repair &amp; Installation
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Leak Detection &amp; Repair
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Sewer Line Services
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-4 h-4 text-green-600 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"></path></svg
              > Servicio en Español
            </li>
          </ul>
        </div>
        <div class="bg-brand-blue text-white rounded-xl p-6">
          <h2 class="font-heading font-bold text-lg mb-3">Contact Us</h2>
          <div class="space-y-3 text-sm">
            <a
              href="tel:+17736103344"
              class="flex items-center gap-2 font-bold hover:text-brand-red transition-colors"
              ><Phone size={16} aria-hidden="true" /> (773) 610-3344</a
            >
            <p class="flex items-start gap-2 text-gray-200">
              <MapPin size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
              <span>Serving Roscoe Village (60618) and all of Chicagoland</span>
            </p>
            <p class="flex items-start gap-2 text-gray-200">
              <Clock size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
              <span>Available 24/7 — including holidays</span>
            </p>
            <a
              href="/contact"
              class="block w-full text-center bg-white text-brand-blue font-bold py-2.5 px-4 rounded-lg hover:bg-gray-100 transition mt-4"
              >Get Free Estimate →</a
            >
          </div>
        </div>
      </div>
      <ServiceAreaMap />
      <div class="mt-8"><EmergencyCTA compact /></div>
      <div class="bg-white rounded-xl p-6 md:p-8 mt-8">
        <h2 class="text-2xl font-heading font-bold text-brand-blue mb-4">
          Request Service in Roscoe Village
        </h2>
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</PageLayout>
