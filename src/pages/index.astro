---
import { Wrench, DollarSign, AlarmClock, Globe, Phone } from 'lucide-react';
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { reviews as allReviews } from '../data/reviews';
import TrustBadges from '../components/ui/TrustBadges.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import ReviewCard from '../components/ui/ReviewCard.astro';
import ServiceAreaMap from '../components/ui/ServiceAreaMap.astro';
import EmergencyCTA from '../components/ui/EmergencyCTA.astro';
import BlogCard from '../components/ui/BlogCard.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const reviews = allReviews.sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 6);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const neighborhoods = [
  'Irving Park',
  'Logan Square',
  'Avondale',
  'Roscoe Village',
  'Wicker Park',
  'Bucktown',
  'Lakeview',
  'Lincoln Square',
  'North Center',
  'Belmont-Cragin',
  'Hermosa',
  'Portage Park',
];
---

<PageLayout
  title="Chicago Plumber — 24/7 Emergency Service | Sandoval Plumbing"
  description="Sandoval Plumbing — Chicago's trusted family plumber. 25+ years, 300+ 5-star reviews. Available 24/7 including holidays. Call (773) 610-3344 for a free estimate."
>
  <!-- C. HERO SECTION -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    {/* Hero background image */}
    <div class="absolute inset-0">
      <img
        src="/cover.jpg"
        alt="Sandoval Plumbing — Chicago's trusted 24/7 plumber serving since 1999"
        loading="eager"
        class="w-full h-full object-cover"
      />
      {/* Dark overlay for text readability */}
      <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 py-20 md:py-28 w-full z-10">
      <div class="max-w-3xl">
        {/* Eyebrow — matching CAB's clean text badge */}
        <span
          class="inline-block text-white/80 text-sm font-semibold tracking-[0.2em] uppercase mb-6"
        >
          Family-Owned Since 1999
        </span>

        {/* Headline — clean, single-line, no red accent span */}
        <h1
          class="text-4xl md:text-5xl lg:text-[50px] font-heading font-bold text-white mb-5 leading-[1.1]"
        >
          Chicago's Trusted 24/7 Plumber
        </h1>

        {/* Subheadline — tightened */}
        <p class="text-base md:text-lg text-gray-300 mb-8 max-w-2xl leading-relaxed">
          Fair prices, real results. Eddie Sandoval brings 25+ years of expert service to your door
          — any time, any day.
        </p>

        {/* Social proof badge — compact, single-line (replacing EPA badge with reviews) */}
        <div
          class="flex items-center gap-2 text-sm text-white/70 mb-8"
          aria-label="4.9 out of 5 stars from over 300 Google reviews"
        >
          <span class="text-yellow-400" aria-hidden="true">★★★★★</span>
          <span class="font-semibold text-white">4.9</span>
          <span aria-hidden="true">·</span>
          <span>300+ 5-Star Reviews</span>
        </div>

        {/* Single primary CTA — matching CAB's clean one-button approach */}
        <div class="flex flex-col sm:flex-row items-start gap-3">
          <a
            href="tel:+17736103344"
            class="inline-flex items-center justify-center gap-2 bg-brand-red text-white px-7 py-3.5 rounded-md text-sm font-semibold uppercase tracking-wider hover:opacity-90 transition shadow-lg"
          >
            Call Now: (773) 610-3344
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 text-white/70 text-sm font-medium hover:text-brand-red transition-colors py-3.5"
          >
            Get Free Estimate →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- D. TRUST BADGES BAR -->
  <TrustBadges />

  <!-- E. WHY SANDOVAL SECTION -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        Why Hundreds of Chicago Homeowners Choose Sandoval
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-12">
        We're not a franchise or a call center. We're your neighbors — and we treat your home like
        our own.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="mb-4 flex justify-center">
            <Wrench size={36} class="text-brand-blue" aria-hidden="true" />
          </div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">Eddie Does the Work</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            When you call Sandoval, you get Eddie — not a dispatcher, not a salesperson, not a
            franchise technician. Over 25 years of hands-on experience.
          </p>
        </div>
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="mb-4 flex justify-center">
            <DollarSign size={36} class="text-brand-blue" aria-hidden="true" />
          </div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">
            Fair, Transparent Pricing
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            We save homeowners 3–6x compared to large plumbing companies. You'll always know the
            price before we start — no hidden fees, no surprises.
          </p>
        </div>
        <div
          class="text-center p-8 rounded-xl bg-brand-lightgray hover:shadow-md transition-shadow"
        >
          <div class="mb-4 flex justify-center">
            <AlarmClock size={36} class="text-brand-blue" aria-hidden="true" />
          </div>
          <h3 class="font-heading font-bold text-brand-blue text-xl mb-3">
            True 24/7 Availability
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Nights, weekends, holidays — we never close. When other plumbers charge double for a
            Sunday call, Eddie answers at the same fair rate.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- F. SERVICES GRID -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        Our Plumbing Services
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-12">
        Residential and commercial plumbing — from emergency repairs to complete remodels.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              icon={service.data.icon}
              href={`/services/${service.data.slug}`}
              emergency={service.data.emergency}
            />
          ))
        }
      </div>
      <div class="text-center mt-10">
        <a
          href="/services"
          class="inline-flex items-center gap-2 bg-brand-blue text-white font-bold px-8 py-3.5 rounded-lg hover:opacity-90 transition shadow-md"
        >
          View All Services →
        </a>
      </div>
    </div>
  </section>

  <!-- G. SOCIAL PROOF / REVIEWS SECTION -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mb-3">
            What Our Customers Say
          </h2>
          <p class="text-gray-500 max-w-xl">
            With over 300 5-star reviews across Google and Yelp, we let our work speak for itself.
          </p>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="text-blue-600">G</span> 4.9 ★
          </span>
          <span class="text-gray-300">|</span>
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="text-red-600">Y</span> 5.0 ★
          </span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          reviews.map((review) => (
            <ReviewCard
              reviewer={review.reviewer}
              rating={review.rating}
              platform={review.platform}
              text={review.text}
              verified={review.verified}
              date={review.date.toLocaleDateString('en-US', {
                month: 'short',
                year: 'numeric',
              })}
              sourceUrl={review.sourceUrl}
            />
          ))
        }
      </div>
      <div class="text-center mt-10">
        <a
          href="/reviews"
          class="inline-flex items-center gap-2 text-brand-blue font-bold hover:text-brand-red transition-colors"
        >
          See All 300+ Reviews →
        </a>
      </div>
    </div>
  </section>

  <!-- H. SERVICE AREA MAP -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue text-center mb-4">
        We Serve All of Chicagoland
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-8">
        Based in Irving Park, we're minutes away from most Chicago neighborhoods.
      </p>
      <ServiceAreaMap />
      <div class="flex flex-wrap justify-center gap-2 mt-6">
        {
          neighborhoods.map((hood) => (
            <a
              key={hood}
              href={`/service-areas/${hood.toLowerCase().replace(/\s+/g, '-')}`}
              class="inline-block bg-white hover:bg-brand-blue hover:text-white text-gray-600 text-sm font-medium px-3 py-1.5 rounded-full border border-gray-200 hover:border-brand-blue transition-colors"
            >
              {hood}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- I. ABOUT SNIPPET -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="aspect-[4/3] rounded-xl overflow-hidden relative">
          <img
            src="/eddie.jpg"
            alt="Eduardo 'Eddie' Sandoval, owner and lead plumber of Sandoval Plumbing — over 25 years serving Chicago"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-brand-blue/20 to-transparent pointer-events-none"
            aria-hidden="true"
          >
          </div>
        </div>
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider"
            >Our Story</span
          >
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mt-2 mb-6">
            Over 25 Years of Keeping Chicago's Pipes Flowing
          </h2>
          <blockquote
            class="text-lg text-gray-600 leading-relaxed mb-6 border-l-4 border-brand-red pl-4 italic"
          >
            "I'm Eddie Sandoval. I've been fixing Chicago's plumbing for over 25 years. I started
            this business because I believe homeowners deserve honest, affordable service from
            someone who actually shows up. That's still how we operate today — one job, one
            customer, one fair price at a time."
          </blockquote>
          <p class="text-gray-500 mb-6">
            Hispanic-owned and family-operated, we're proud to serve Chicago's diverse communities
            with bilingual service and the same values we've had since day one.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-brand-blue font-bold hover:text-brand-red transition-colors"
          >
            Read Our Story →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- J. EMERGENCY CTA SECTION -->
  <section class="py-16 md:py-20 bg-brand-lightgray">
    <div class="max-w-4xl mx-auto px-4">
      <EmergencyCTA />
    </div>
  </section>

  <!-- K. BLOG PREVIEW -->
  {
    blogPosts.length > 0 && (
      <section class="py-16 md:py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-blue mb-3">
                Chicago Plumbing Tips
              </h2>
              <p class="text-gray-500 max-w-xl">
                Expert advice from Eddie on keeping your plumbing in top shape through every Chicago
                season.
              </p>
            </div>
            <a
              href="/blog"
              class="text-brand-blue font-bold hover:text-brand-red transition-colors"
            >
              View All Posts →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {blogPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- L. BILINGUAL CTA -->
  <section class="py-12 md:py-16 bg-brand-blue">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="mb-4 flex justify-center">
        <Globe size={40} class="text-white/80" aria-hidden="true" />
      </div>
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">¿Hablas español?</h2>
      <p class="text-gray-300 text-lg mb-6 max-w-xl mx-auto">
        También ofrecemos servicio completo en español. Eddie es bilingüe y atiende a la comunidad
        hispana de Chicago con el mismo compromiso y calidad.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/es"
          class="inline-flex items-center gap-2 bg-white text-brand-blue font-bold px-8 py-3.5 rounded-lg hover:bg-gray-100 transition shadow-md"
        >
          Visitar en Español →
        </a>
        <a
          href="tel:+17736103344"
          class="inline-flex items-center gap-2 text-white font-bold hover:underline"
        >
          <Phone size={16} aria-hidden="true" /> (773) 610-3344
        </a>
      </div>
    </div>
  </section>
</PageLayout>
