---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  emergency?: boolean;
}

const { title, description, icon, href, emergency = false } = Astro.props;
---

<a
  href={href}
  class="group block bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 p-6 relative overflow-hidden"
>
  {
    emergency && (
      <span class="absolute top-0 right-0 bg-brand-red text-white text-[10px] font-bold px-2 py-0.5 rounded-bl-lg uppercase tracking-wider">
        24/7 Emergency
      </span>
    )
  }
  <div class="text-3xl mb-3" aria-hidden="true">{icon}</div>
  <h3
    class="font-heading font-bold text-brand-blue text-lg mb-2 group-hover:text-brand-red transition-colors"
  >
    {title}
  </h3>
  <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
  <span
    class="inline-flex items-center text-brand-blue text-sm font-semibold mt-3 group-hover:text-brand-red transition-colors"
  >
    Learn More
    <svg
      class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7"></path>
    </svg>
  </span>
</a>
