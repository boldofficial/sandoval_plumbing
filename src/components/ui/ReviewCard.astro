---
interface Props {
  reviewer: string;
  rating: number;
  platform: 'google' | 'yelp' | 'other';
  text: string;
  verified?: boolean;
  date?: string;
}

const { reviewer, rating, platform, text, verified = true, date } = Astro.props;

const platformIcons: Record<string, string> = {
  google: 'G',
  yelp: 'Y',
  other: '★',
};

const platformColors: Record<string, string> = {
  google: 'text-blue-600',
  yelp: 'text-red-600',
  other: 'text-yellow-500',
};
---

<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 flex flex-col h-full">
  {/* Stars */}
  <div class="flex gap-0.5 mb-3" aria-label={`${rating} out of 5 stars`}>
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg
          key={i}
          class={`w-5 h-5 ${i < rating ? 'text-yellow-400' : 'text-gray-200'}`}
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))
    }
  </div>

  {/* Review text */}
  <p class="text-gray-600 text-sm leading-relaxed flex-1 italic">"{text}"</p>

  {/* Reviewer info */}
  <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="font-semibold text-gray-800 text-sm">{reviewer}</span>
      {
        verified && (
          <span class="text-green-600 text-xs font-medium" title="Verified review">
            ✅ Verified
          </span>
        )
      }
    </div>
    <span class={`text-xs font-bold ${platformColors[platform]}`}>
      {platformIcons[platform]}
      {platform === 'google' ? 'Google' : platform === 'yelp' ? 'Yelp' : ''}
    </span>
  </div>
</div>
