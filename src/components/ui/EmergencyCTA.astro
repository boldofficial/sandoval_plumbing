---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  class={`rounded-xl bg-brand-red text-white text-center ${compact ? 'p-6' : 'p-8 md:p-12'}`}
>
  <h2 class={`font-heading font-bold ${compact ? 'text-xl' : 'text-2xl md:text-3xl'} mb-3`}>
    {compact ? '🚨 24/7 Emergency Service' : "Plumbing Emergency? Don't Wait."}
  </h2>
  <p class={`${compact ? 'text-sm' : 'text-base md:text-lg'} mb-4 opacity-90`}>
    We respond within 60 minutes — every day, every night, including holidays.
  </p>
  <a
    href="tel:+17736103344"
    class="inline-block bg-white text-brand-red font-bold px-6 py-3 rounded-lg text-lg hover:bg-gray-100 transition shadow-lg"
  >
    Call (773) 610-3344
  </a>
  {
    !compact && (
      <p class="mt-3 text-sm opacity-80">No voicemail. No dispatcher. Talk to Eddie directly.</p>
    )
  }
</section>
