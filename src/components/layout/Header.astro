---
import MobileNav from '../islands/MobileNav';

const navLinks = [
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-40 bg-white shadow-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20">
      {/* Logo */}
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Sandoval Plumbing - Home">
        <span class="text-2xl" aria-hidden="true">🔧</span>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-brand-blue text-lg md:text-xl leading-tight">
            Sandoval <span class="text-brand-red">Plumbing</span>
          </span>
          <span class="text-[10px] md:text-xs text-gray-500 leading-tight -mt-0.5">
            Chicago's Trusted 24/7 Plumber
          </span>
        </div>
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {
          navLinks.map((link) => (
            <a
              key={link.href}
              href={link.href}
              class="px-3 lg:px-4 py-2 text-sm lg:text-base font-semibold text-gray-600 hover:text-brand-blue rounded-lg hover:bg-brand-lightgray transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        {/* Language toggle */}
        <a
          href="/es"
          class="px-3 py-2 text-sm font-semibold text-gray-500 hover:text-brand-blue transition-colors"
          aria-label="Español"
        >
          🌎 ES
        </a>
      </nav>

      {/* Desktop CTA */}
      <div class="hidden md:flex items-center gap-3">
        <a
          href="tel:+17736103344"
          class="text-sm lg:text-base font-bold text-brand-blue hover:text-brand-red transition-colors"
        >
          (773) 610-3344
        </a>
        <a
          href="/contact"
          class="bg-brand-red text-white font-bold text-sm lg:text-base px-4 lg:px-6 py-2.5 rounded-lg hover:opacity-90 transition shadow-sm"
        >
          Free Estimate
        </a>
      </div>

      {/* Mobile Hamburger */}
      <MobileNav client:load />
    </div>
  </div>
</header>
